    {"code": "2.B", "family": "2", "name": "Evaluate experimental design elements"},
    {"code": "2.C", "family": "2", "name": "Evaluate non-experimental design elements"},
    {"code": "2.D", "family": "2", "name": "Evaluate research ethics"},
    {"code": "3.A", "family": "3", "name": "Identify concepts and variables in data"},
    {"code": "3.B", "family": "3", "name": "Calculate and interpret descriptive statistics and percentile rank"},
    {"code": "3.C", "family": "3", "name": "Interpret quantitative or qualitative inferential data"},
    {"code": "4.A", "family": "4", "name": "Propose a defensible claim"},
    {"code": "4.B", "family": "4", "name": "Use scientific evidence to justify an argument"}
