  "corrections": [
    {"id": "perspectives-list", "rule": "Practice 1.A includes biological, behavioral, cognitive, evolutionary, humanistic, psychodynamic, and sociocultural perspectives.", "source": "psychology-clarifications"},
    {"id": "effect-size-significance", "rule": "Use the clarified Practice 3.C distinctions for effect size and statistical significance.", "source": "psychology-clarifications"},
    {"id": "all-or-none", "rule": "Use the term all-or-none principle.", "source": "psychology-clarifications"},
    {"id": "reticular-alertness", "rule": "Alertness is a function of the reticular activating system.", "source": "psychology-clarifications"},
    {"id": "hypnagogic-spelling", "rule": "Use the spelling hypnagogic.", "source": "psychology-clarifications"},
    {"id": "spontaneous-recovery", "rule": "An extinguished conditioned response may reappear when the conditioned stimulus is presented after extinction.", "source": "psychology-clarifications"},
    {"id": "reinforcement-schedules", "rule": "Use fixed-interval, variable-interval, fixed-ratio, and variable-ratio.", "source": "psychology-clarifications"},
    {"id": "aaq-ethics", "rule": "AAQ ethics requires both identifying a described guideline and explaining how the researchers applied it.", "source": "psychology-clarifications"},
    {"id": "ebq-evidence", "rule": "EBQ evidence must be accurate, specific, and relevant, and reasoning must apply course content to the evidence-to-claim link.", "source": "psychology-clarifications"}
