{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AP Precalculus & Calculus Advisor Generated Content",
  "description": "One generated item. Topic mapping, mathematical practice, and exam-task metadata are separate claims.",
  "type": "object",
  "required": [
    "course",
    "unit",
    "topic",
    "topic_exam_scope",
    "type",
    "difficulty",
    "style",
    "answer_visibility",
    "mathematical_practices",
    "methods",
    "supporting_topics",
    "citation_validation",
    "content"
  ],
  "properties": {
    "course": {
      "type": "string",
      "enum": ["precalculus", "calc-ab", "calc-bc"]
    },
    "unit": {
      "type": "string",
      "pattern": "^Unit (?:[1-9]|10)$"
    },
    "topic": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[1-9][0-9]* .+$",
      "description": "Primary internal content-Topic label, not an official quotation."
    },
    "topic_exam_scope": {
      "type": "string",
      "enum": ["assessed", "not-assessed"]
    },
    "type": {
      "type": "string",
      "enum": ["explanation", "practice_problem", "worked_example"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["foundational", "standard", "challenge"]
    },
    "style": {
      "type": "string",
      "enum": ["instructional", "assessed-topic", "exam-oriented"],
      "description": "assessed-topic means only assessed Topic scope. exam-oriented additionally requires explicit exam_features. Deprecated ap-oriented input is normalized before output."
    },
    "answer_visibility": {
      "type": "string",
      "enum": ["hidden", "revealed"],
      "description": "hidden forbids answer and solution fields; reveal only when the user explicitly requests them or requests a worked example."
    },
    "mathematical_practices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"},
      "description": "Practice dimension, recorded separately from the content Topic."
    },
    "methods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["integration-by-parts", "shell-method"]
      },
      "description": "Declare only high-risk methods from ap-content-boundaries.json; use [] when none is present."
    },
    "supporting_topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["unit", "topic", "topic_exam_scope"],
        "properties": {
          "unit": {"type": "string", "pattern": "^Unit (?:[1-9]|10)$"},
          "topic": {
            "type": "string",
            "pattern": "^[1-9][0-9]*\\.[1-9][0-9]* .+$"
          },
          "topic_exam_scope": {
            "type": "string",
            "enum": ["assessed", "not-assessed"]
          }
        },
        "additionalProperties": false
      }
    },
    "exam_features": {
      "type": "object",
      "description": "Exam-task metadata. AP Precalculus free-response items additionally require a named free-response type.",
      "required": ["question_type", "calculator", "representations", "justification"],
      "properties": {
        "question_type": {
          "type": "string",
          "enum": ["multiple-choice", "free-response"]
        },
        "free_response_type": {
          "type": "string",
          "enum": [
            "function-concepts",
            "modeling-non-periodic-context",
            "modeling-periodic-context",
            "symbolic-manipulations"
          ],
          "description": "Required only for AP Precalculus free-response tasks; forbidden for multiple-choice and Calculus tasks."
        },
        "calculator": {
          "type": "string",
          "enum": ["calculator-required-section", "calculator-not-permitted"]
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "The official Precalculus families are analytical, graphical, numerical, and verbal; tabular is retained as an internal numerical subtype for shared compatibility.",
          "items": {
            "type": "string",
            "enum": ["analytical", "graphical", "numerical", "tabular", "verbal"]
          }
        },
        "justification": {
          "type": "string",
          "enum": ["required", "not-required"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["free_response_type"],
            "properties": {
              "free_response_type": {
                "enum": ["function-concepts", "modeling-non-periodic-context"]
              }
            }
          },
          "then": {
            "properties": {
              "calculator": {"const": "calculator-required-section"}
            }
          }
        },
        {
          "if": {
            "required": ["free_response_type"],
            "properties": {
              "free_response_type": {
                "enum": ["modeling-periodic-context", "symbolic-manipulations"]
              }
            }
          },
          "then": {
            "properties": {
              "calculator": {"const": "calculator-not-permitted"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "citation_validation": {
      "type": "object",
      "description": "Internal Topic-mapping receipt; never proof of mathematical correctness.",
      "required": ["catalog_match", "automated_status"],
      "properties": {
        "catalog_match": {"const": "exact"},
        "automated_status": {
          "type": "string",
          "enum": ["pass", "not_run"]
        }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "principle": {"type": "string", "minLength": 1},
        "real_world_application": {"type": "string", "minLength": 1},
        "problem_statement": {"type": "string", "minLength": 1},
        "final_answer": {"type": "string", "minLength": 1},
        "solution": {"type": "string", "minLength": 1},
        "common_mistake": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "explanation"}}},
      "then": {"properties": {"content": {"required": ["principle"]}}}
    },
    {
      "if": {"properties": {"type": {"const": "practice_problem"}}},
      "then": {"properties": {"content": {"required": ["problem_statement"]}}}
    },
    {
      "if": {"properties": {"type": {"const": "worked_example"}}},
      "then": {
        "properties": {
          "content": {"required": ["problem_statement", "solution"]}
        }
      }
    },
    {
      "if": {"properties": {"course": {"const": "precalculus"}}},
      "then": {
        "properties": {
          "mathematical_practices": {
            "items": {
              "enum": [
                "precalc-1-procedural-symbolic-fluency",
                "precalc-2-multiple-representations",
                "precalc-3-communication-reasoning"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"course": {"enum": ["calc-ab", "calc-bc"]}}
      },
      "then": {
        "properties": {
          "mathematical_practices": {
            "items": {
              "enum": [
                "calc-1-implementing-processes",
                "calc-2-connecting-representations",
                "calc-3-justification",
                "calc-4-communication-notation"
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"topic_exam_scope": {"const": "not-assessed"}}},
      "then": {"properties": {"style": {"const": "instructional"}}}
    },
    {
      "if": {
        "properties": {
          "style": {
            "enum": ["assessed-topic", "exam-oriented"]
          }
        }
      },
      "then": {
        "properties": {
          "topic_exam_scope": {"const": "assessed"},
          "supporting_topics": {
            "items": {
              "properties": {"topic_exam_scope": {"const": "assessed"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"style": {"const": "exam-oriented"}}},
      "then": {"required": ["exam_features"]},
      "else": {"not": {"required": ["exam_features"]}}
    },
    {
      "if": {
        "required": ["course", "style", "exam_features"],
        "properties": {
          "course": {"const": "precalculus"},
          "style": {"const": "exam-oriented"},
          "exam_features": {
            "required": ["question_type"],
            "properties": {
              "question_type": {"const": "free-response"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "exam_features": {"required": ["free_response_type"]}
        }
      },
      "else": {
        "properties": {
          "exam_features": {
            "not": {"required": ["free_response_type"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"answer_visibility": {"const": "hidden"}}},
      "then": {
        "properties": {
          "content": {
            "not": {
              "anyOf": [
                {"required": ["final_answer"]},
                {"required": ["solution"]}
              ]
            }
          }
        }
      }
    }
  ]
}
