{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AP Precalculus & Calculus Advisor Machine-Readable Error",
  "description": "Output shape used when a requested generated item cannot satisfy AP Precalculus & Calculus Advisor's hard constraints.",
  "type": "object",
  "required": ["status", "reason", "conflicts", "allowed_alternatives"],
  "properties": {
    "status": {
      "const": "cannot_fulfill"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "conflicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
